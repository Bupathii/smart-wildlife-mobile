{
  "expo": {
    "name": "WildSentinel",
    "slug": "wildsentinel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C342B",
        "foregroundImage": "./assets/brand/wildsentinel-mark.png",
        "backgroundImage": "./assets/brand/app-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C342B",
          "image": "./assets/brand/wildsentinel-mark.png",
          "imageWidth": 155
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Wildlife Conservation to keep tracking the selected animal in the background.",
          "locationWhenInUsePermission": "Allow Wildlife Conservation to access your location while tracking the animal.",
          "isBackgroundLocationEnabled": true,
          "foregroundService": {
            "notificationTitle": "Wildlife tracking active",
            "notificationBody": "Sending animal GPS updates to the ranger backend."
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
